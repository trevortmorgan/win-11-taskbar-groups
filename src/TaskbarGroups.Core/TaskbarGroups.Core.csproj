<Project Sdk="Microsoft.NET.Sdk">

  <!-- UI-free logic (config, layout). Kept separate so tests don't need to load WinUI. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <!-- Group icons: a curated subset of Microsoft's Fluent UI System Icons (MIT, see Icons/Fluent/LICENSE). -->
  <ItemGroup>
    <EmbeddedResource Include="Icons\Fluent\*.svg" LogicalName="Fluent/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
