<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="TaskbarGroups.GroupsFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TaskbarGroups"
    Title="Taskbar Groups flyout">

    <!-- Opens above the "Groups" button and lists every group (see #mobile-flyout in design/taskbar_groups.html).
         The window itself is transparent; the rounded acrylic panel is drawn by Panel. -->
    <Grid x:Name="Root" Background="Transparent" RequestedTheme="Dark" KeyDown="OnKeyDown" PreviewKeyDown="OnPreviewKeyDown"
          TabFocusNavigation="Cycle">
        <Grid.Resources>
            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
        </Grid.Resources>

        <Border x:Name="Panel" Width="288" VerticalAlignment="Bottom" CornerRadius="16"
                BorderBrush="#804B5563" BorderThickness="1">
            <Grid>
                <SystemBackdropElement CornerRadius="16">
                    <SystemBackdropElement.SystemBackdrop>
                        <DesktopAcrylicBackdrop />
                    </SystemBackdropElement.SystemBackdrop>
                </SystemBackdropElement>
                <Rectangle Fill="#99111827" />

                <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
                    <ItemsControl x:Name="GroupList" Margin="16" IsTabStop="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="16" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:GroupView">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Padding="4,0">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{x:Bind local:BindingHelpers.Brush(Color)}" />
                                        <TextBlock Text="{x:Bind Name}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{x:Bind local:BindingHelpers.Light(Color)}" />
                                    </StackPanel>
                                    <Border Padding="6" CornerRadius="12" Background="#0DFFFFFF" BorderBrush="#0DFFFFFF" BorderThickness="1">
                                        <ItemsControl ItemsSource="{x:Bind Apps}" IsTabStop="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <!-- Wraps onto more rows if a group has more apps than fit across. -->
                                                    <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="44" ItemHeight="44" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:AppTile">
                                                    <Button Width="40" Height="40" Padding="0" CornerRadius="8" Tag="{x:Bind}" Click="OnAppClick"
                                                            ToolTipService.ToolTip="{x:Bind Name}" AutomationProperties.Name="{x:Bind Name}">
                                                        <Grid>
                                                            <Image Source="{x:Bind Icon}" Width="{x:Bind IconSize}" Height="{x:Bind IconSize}" Stretch="Uniform" />
                                                            <TextBlock Text="{x:Bind Initial}" Visibility="{x:Bind InitialVisibility}" FontSize="14"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
