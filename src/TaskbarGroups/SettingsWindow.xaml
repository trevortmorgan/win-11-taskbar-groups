<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="TaskbarGroups.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TaskbarGroups"
    Title="Taskbar Groups settings">

    <!-- A Windows 11 settings-style window: the groups on the left, the selected group on the right.
         Every change is saved straight away, and the strip on the taskbar updates by itself. -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar x:Name="ErrorBar" Severity="Error" IsClosable="False" IsOpen="False" Margin="16,12,16,0" />

        <Grid x:Name="Editor" Grid.Row="1" ColumnDefinitions="280,*">
            <!-- Groups -->
            <Grid Margin="16,16,8,16" RowDefinitions="Auto,*,Auto" RowSpacing="8">
                <TextBlock Text="Groups" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ListView x:Name="GroupList" Grid.Row="1" SelectionMode="Single" CanReorderItems="True" AllowDrop="True"
                          SelectionChanged="OnGroupSelected" AutomationProperties.Name="Groups">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:EditableGroup">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Height="44">
                                <Border Width="28" Height="28" CornerRadius="8" VerticalAlignment="Center"
                                        Background="{x:Bind local:BindingHelpers.Tint(Color, 0.2), Mode=OneWay}"
                                        BorderBrush="{x:Bind local:BindingHelpers.Brush(Color), Mode=OneWay}" BorderThickness="0,2,0,0">
                                    <local:GroupMark Icon="{x:Bind ResolvedIcon, Mode=OneWay}" Color="{x:Bind Color, Mode=OneWay}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                    <Button Click="OnAddGroup" Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="Add group" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnMoveGroupUp" AutomationProperties.Name="Move group up" ToolTipService.ToolTip="Move up">
                        <FontIcon Glyph="&#xE70E;" FontSize="14" />
                    </Button>
                    <Button Click="OnMoveGroupDown" AutomationProperties.Name="Move group down" ToolTipService.ToolTip="Move down">
                        <FontIcon Glyph="&#xE70D;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- The selected group -->
            <ScrollViewer x:Name="Detail" Grid.Column="1" Padding="8,16,16,16">
                <StackPanel Spacing="20" MaxWidth="640" HorizontalAlignment="Left">
                    <TextBox x:Name="NameBox" Header="Name" Width="320" HorizontalAlignment="Left" MaxLength="40"
                             TextChanged="OnNameChanged" />

                    <StackPanel Spacing="8">
                        <TextBlock Text="Colour" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <StackPanel x:Name="Swatches" Orientation="Horizontal" Spacing="8" />
                            <Button x:Name="CustomColorButton" Width="32" Height="32" Padding="0" CornerRadius="16"
                                    ToolTipService.ToolTip="Custom colour" AutomationProperties.Name="Custom colour">
                                <FontIcon Glyph="&#xE790;" FontSize="14" />
                                <Button.Flyout>
                                    <Flyout Placement="Bottom">
                                        <ColorPicker x:Name="Picker" IsAlphaEnabled="False" IsMoreButtonVisible="False"
                                                     IsColorChannelTextInputVisible="False" ColorChanged="OnPickerColorChanged" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Icon" />
                        <Button x:Name="IconButton" MinWidth="160" HorizontalAlignment="Left" AutomationProperties.Name="Choose icon">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <local:GroupMark x:Name="IconPreview" VerticalAlignment="Center" />
                                <TextBlock x:Name="IconLabel" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout x:Name="IconFlyout" Placement="Bottom" Opening="OnIconFlyoutOpening">
                                    <StackPanel Spacing="8" Width="360">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <AutoSuggestBox x:Name="IconSearch" PlaceholderText="Search icons" QueryIcon="Find"
                                                            TextChanged="OnIconSearchChanged" />
                                            <Button Grid.Column="1" Content="No icon" Click="OnNoIcon" />
                                        </Grid>
                                        <GridView x:Name="IconGrid" Height="300" SelectionMode="None" IsItemClickEnabled="True"
                                                  ItemClick="OnIconClick">
                                            <GridView.ItemTemplate>
                                                <DataTemplate x:DataType="local:IconChoice">
                                                    <Grid Width="48" Height="48" ToolTipService.ToolTip="{x:Bind Name}"
                                                          AutomationProperties.Name="{x:Bind Name}">
                                                        <local:GroupMark Icon="{x:Bind Icon}" Color="{x:Bind Color, Mode=OneWay}"
                                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </GridView.ItemTemplate>
                                        </GridView>
                                        <Button Content="Use my own .svg file…" Click="OnBrowseSvg" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Apps" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Click="OnBrowseApp">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                                        <TextBlock Text="Browse…" />
                                    </StackPanel>
                                </Button>
                                <Button Click="OnPickInstalled">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE71D;" FontSize="14" />
                                        <TextBlock Text="Installed apps…" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Files and shortcuts dropped anywhere in this box are added. -->
                        <Border x:Name="AppsDrop" AllowDrop="True" DragOver="OnAppsDragOver" Drop="OnAppsDrop" MinHeight="96"
                                CornerRadius="8" BorderThickness="1" Padding="4"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Grid>
                                <ListView x:Name="AppList" SelectionMode="None" CanReorderItems="True" AllowDrop="True"
                                          AutomationProperties.Name="Apps in this group">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:EditableApp">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Height="56">
                                                <Grid Width="32" Height="32" VerticalAlignment="Center">
                                                    <Image Source="{x:Bind Icon, Mode=OneWay}" Width="24" Height="24" Stretch="Uniform" />
                                                </Grid>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBox Text="{x:Bind Name, Mode=TwoWay}" BorderThickness="0" Background="Transparent"
                                                             Padding="4,2" MaxLength="60" AutomationProperties.Name="App name" />
                                                    <TextBlock Text="{x:Bind Path}" Margin="4,0,0,0" FontSize="11" TextTrimming="CharacterEllipsis"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Tag="{x:Bind}" Click="OnRemoveApp" Background="Transparent" BorderThickness="0"
                                                        ToolTipService.ToolTip="Remove" AutomationProperties.Name="Remove app">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock x:Name="AppsEmpty" Text="No apps yet. Drop a shortcut or .exe here, or use the buttons above."
                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" IsHitTestVisible="False"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Button Click="OnDeleteGroup" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            <TextBlock Text="Delete group" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <TextBlock x:Name="NoSelection" Grid.Column="1" Text="Add a group to get started." Visibility="Collapsed"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</Window>
