<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="TaskbarGroups.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:config="using:TaskbarGroups.Config"
    xmlns:local="using:TaskbarGroups"
    Title="Taskbar Groups">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <StackPanel Margin="24" Spacing="12">
        <TextBlock Text="Taskbar Groups — milestone 0" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
        <ItemsControl x:Name="GroupList">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="config:Group">
                    <Border BorderBrush="{x:Bind local:BindingHelpers.Brush(Color)}" BorderThickness="0,2,0,0" CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="9" Height="9" Fill="{x:Bind local:BindingHelpers.Brush(Color)}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                            <TextBlock Opacity="0.6">
                                <Run Text="{x:Bind Apps.Count}" /> apps
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</Window>
