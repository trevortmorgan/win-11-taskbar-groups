<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="TaskbarGroups.StripWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TaskbarGroups"
    Title="Taskbar Groups">

    <!-- Sits on the taskbar. Transparent everywhere except the pills themselves. -->
    <Grid x:Name="Root" Background="Transparent">
        <Grid.Resources>
            <ResourceDictionary>
            <!-- App buttons: no chrome until hovered, like taskbar buttons. -->
            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark"><StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="TgHover" /><StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="TgPressed" /></ResourceDictionary>
                <ResourceDictionary x:Key="Light"><StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="TgHover" /><StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="TgPressed" /></ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
        </Grid.Resources>
        <Grid.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem Text="Settings" Click="OnSettingsClick">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Exit Taskbar Groups" Click="OnExitClick">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE7E8;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Grid.ContextFlyout>

        <!-- Wide layout: one pill per group (see design/large-screen.png). -->
        <ItemsControl x:Name="Pills" HorizontalAlignment="Left" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="6" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:GroupView">
                    <Border Height="42" Padding="3,0" CornerRadius="10"
                            Background="{x:Bind local:BindingHelpers.Tint(Color, 0.12)}"
                            BorderBrush="{x:Bind local:BindingHelpers.Brush(Color)}" BorderThickness="0,2,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="7" Padding="7,0,6,0" VerticalAlignment="Center">
                                <local:GroupMark Icon="{x:Bind Icon}" Color="{x:Bind Color}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind Name}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{x:Bind local:BindingHelpers.Light(Color)}" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{x:Bind Apps}" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:AppTile">
                                        <Button Width="36" Height="36" Padding="0" CornerRadius="6" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Tag="{x:Bind}" Click="OnAppClick"
                                                ToolTipService.ToolTip="{x:Bind Name}" AutomationProperties.Name="{x:Bind Name}">
                                            <Grid>
                                                <Image Source="{x:Bind Icon}" Width="{x:Bind IconSize}" Height="{x:Bind IconSize}" Stretch="Uniform" />
                                                <TextBlock Text="{x:Bind Initial}" Visibility="{x:Bind InitialVisibility}" FontSize="13"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <!-- Running: short grey bar; in front: longer accent bar. -->
                                                <Border Height="3" CornerRadius="1.5" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1"
                                                        Visibility="{x:Bind IndicatorVisibility, Mode=OneWay}" Width="{x:Bind IndicatorWidth, Mode=OneWay}"
                                                        Background="{x:Bind IndicatorBrush, Mode=OneWay}" IsHitTestVisible="False" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Narrow layout: everything collapses into one button (see design/small-screen.png). -->
        <Button x:Name="GroupsButton" Height="42" Padding="12,0" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Center"
                Background="{ThemeResource TgCollapsedBackground}" BorderBrush="{ThemeResource TgCollapsedBorder}" BorderThickness="1" Opacity="0" IsHitTestVisible="False"
                Click="OnGroupsClick" AutomationProperties.Name="Groups">
            <Button.Resources>
                <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Dark">
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="TgCollapsedBackgroundHover" />
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="TgCollapsedBackgroundPressed" />
                        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="TgCollapsedBorder" />
                        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="TgCollapsedBorder" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Light">
                        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="TgCollapsedBackgroundHover" />
                        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="TgCollapsedBackgroundPressed" />
                        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="TgCollapsedBorder" />
                        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="TgCollapsedBorder" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
            </Button.Resources>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE81E;" FontSize="14" Foreground="{ThemeResource TgAccent}" />
                <TextBlock Text="Groups" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <!-- Points down while the flyout is open. -->
                <FontIcon x:Name="Chevron" Glyph="&#xE70E;" FontSize="10">
                    <FontIcon.RotationTransition>
                        <ScalarTransition Duration="0:0:0.2" />
                    </FontIcon.RotationTransition>
                </FontIcon>
            </StackPanel>
        </Button>
    </Grid>
</Window>
